# Entity: integration_response_dto

main: kit: entity: integration_response_dto: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      r: true
      sh: "Indicates whether the integration is currently active."
      t: "`$BOOLEAN`"
    }
    channel: {
      h: "Channel"
      n: "channel"
      r: false
      sh: "The channel type for the integration, which defines how it communicates (e.g., email, SMS)."
      t: "`$STRING`"
    }
    conditions: {
      de: true
      h: "Conditions"
      n: "conditions"
      r: false
      sh: "Legacy StepFilter conditions."
      t: "`$ARRAY`"
    }
    configurations: {
      h: "Configurations"
      n: "configurations"
      r: false
      sh: "The configurations required for enabling the additional configurations of the integration."
      t: "`$ANY`"
    }
    credentials: {
      h: "Credentials"
      n: "credentials"
      r: false
      sh: "The decrypted credentials required for the integration to function (e.g."
      t: "`$ANY`"
    }
    deleted: {
      h: "Deleted"
      n: "deleted"
      r: true
      sh: "Indicates whether the integration has been marked as deleted (soft delete)."
      t: "`$BOOLEAN`"
    }
    deletedAt: {
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "The timestamp indicating when the integration was deleted."
      t: "`$STRING`"
    }
    deletedBy: {
      h: "Deleted By"
      n: "deletedBy"
      r: false
      sh: "The identifier of the user who performed the deletion of this integration."
      t: "`$STRING`"
    }
    environmentId: {
      h: "Environment Id"
      n: "environmentId"
      r: true
      sh: "The unique identifier for the environment associated with this integration."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier of the integration record in the database."
      t: "`$STRING`"
    }
    identifier: {
      h: "Identifier"
      n: "identifier"
      r: true
      sh: "A unique string identifier for the integration, often used for API calls or internal references."
      t: "`$STRING`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      sh: "Distinguishes delivery integrations from agent-runtime integrations."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the integration, which is used to identify it in the user interface."
      t: "`$STRING`"
    }
    organizationId: {
      h: "Organization Id"
      n: "organizationId"
      r: true
      sh: "The unique identifier for the organization that owns this integration."
      t: "`$STRING`"
    }
    primary: {
      h: "Primary"
      n: "primary"
      r: true
      sh: "Indicates whether this integration is marked as primary."
      t: "`$BOOLEAN`"
    }
    providerId: {
      h: "Provider Id"
      n: "providerId"
      r: true
      sh: "The identifier for the provider of the integration (e.g., \"mailgun\", \"twilio\")."
      t: "`$STRING`"
    }
    rules: {
      h: "Rules"
      n: "rules"
      r: false
      sh: "JSONLogic used at send time to select this integration."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "integration_response_dto"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/integrations/{integrationId}/set-primary"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                k: "param"
                n: "id"
                or: "integration_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/integrations/{integrationId}/set-primary"
          q: {
            "$action": "set-primary"
            exist: [
              "id"
              "idempotency_key"
            ]
          }
          r: {
            param: {
              integrationId: "id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "integrations"
            }
            {
              var: "id"
            }
            {
              lit: "set-primary"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/integrations/active"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/integrations/active"
          q: {
            exist: [
              "idempotency_key"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "integrations"
            }
            {
              lit: "active"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



