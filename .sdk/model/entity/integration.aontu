# Entity: integration

main: kit: entity: integration: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      op: {
        list: {
          req: true
          type: "`$BOOLEAN`"
        }
        update: {
          req: true
          type: "`$BOOLEAN`"
        }
      }
      r: false
      sh: "If the integration is active, the validation on the credentials field will run"
      t: "`$BOOLEAN`"
    }
    channel: {
      h: "Channel"
      n: "channel"
      r: false
      sh: "The channel type for the integration."
      t: "`$STRING`"
    }
    check: {
      h: "Check"
      n: "check"
      r: false
      sh: "Flag to check the integration status"
      t: "`$BOOLEAN`"
    }
    conditions: {
      de: true
      h: "Conditions"
      n: "conditions"
      r: false
      sh: "Legacy StepFilter conditions."
      t: "`$ARRAY`"
    }
    configurations: {
      h: "Configurations"
      n: "configurations"
      r: false
      sh: "Configurations for the integration"
      t: "`$OBJECT`"
    }
    credentials: {
      h: "Credentials"
      n: "credentials"
      r: false
      sh: "The credentials for the integration"
      t: "`$ANY`"
    }
    deleted: {
      h: "Deleted"
      n: "deleted"
      r: true
      sh: "Indicates whether the integration has been marked as deleted (soft delete)."
      t: "`$BOOLEAN`"
    }
    deletedAt: {
      h: "Deleted At"
      n: "deletedAt"
      r: false
      sh: "The timestamp indicating when the integration was deleted."
      t: "`$STRING`"
    }
    deletedBy: {
      h: "Deleted By"
      n: "deletedBy"
      r: false
      sh: "The identifier of the user who performed the deletion of this integration."
      t: "`$STRING`"
    }
    environmentId: {
      fo: "uuid"
      h: "Environment Id"
      n: "environmentId"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The ID of the associated environment"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier of the integration record in the database."
      t: "`$STRING`"
    }
    identifier: {
      h: "Identifier"
      n: "identifier"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The unique identifier for the integration"
      t: "`$STRING`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      sh: "Distinguishes delivery integrations from agent-runtime integrations."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The name of the integration"
      t: "`$STRING`"
    }
    organizationId: {
      h: "Organization Id"
      n: "organizationId"
      r: true
      sh: "The unique identifier for the organization that owns this integration."
      t: "`$STRING`"
    }
    primary: {
      h: "Primary"
      n: "primary"
      r: true
      sh: "Indicates whether this integration is marked as primary."
      t: "`$BOOLEAN`"
    }
    providerId: {
      h: "Provider Id"
      n: "providerId"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The provider ID for the integration"
      t: "`$STRING`"
    }
    rules: {
      h: "Rules"
      n: "rules"
      r: false
      sh: "JSONLogic used at send time to select this integration."
      t: "`$OBJECT`"
    }
  }

