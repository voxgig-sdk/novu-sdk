      }
    }
    transactionId: {
      h: "Transaction Id"
      n: "transactionId"
      r: false
      sh: "The returned transaction ID of the trigger"
      t: "`$STRING`"
    }
  }

  name: "trigger_event_response_dto"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/events/trigger/broadcast"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
