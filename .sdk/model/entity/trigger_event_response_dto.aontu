                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/events/trigger/broadcast"
          q: {
            exist: [
              "idempotency_key"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "events"
            }
            {
              lit: "trigger"
            }
            {
              lit: "broadcast"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /v1/events/trigger/bulk"
            source: "openapi3"
            version: 2
          }
          g: {
