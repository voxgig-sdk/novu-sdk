# Entity: trigger_event_response_dto

main: kit: entity: trigger_event_response_dto: {

  alias: field: {}

  fields: {
    acknowledged: {
      h: "Acknowledged"
      n: "acknowledged"
      r: true
      sh: "Indicates whether the trigger was acknowledged or not"
      t: "`$BOOLEAN`"
    }
    activityFeedLink: {
      h: "Activity Feed Link"
      n: "activityFeedLink"
      r: false
      sh: "Link to the activity feed for this trigger event"
      t: "`$STRING`"
    }
