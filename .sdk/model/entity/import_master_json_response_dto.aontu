# Entity: import_master_json_response_dto

main: kit: entity: import_master_json_response_dto: {

  alias: field: {}

  fields: {
    failed: {
      h: "Failed"
      n: "failed"
      r: false
      sh: "List of resource IDs that failed to import"
      t: "`$ARRAY`"
    }
    locale: {
      h: "Locale"
      n: "locale"
      r: true
      sh: "The locale for which translations are being imported"
      t: "`$STRING`"
    }
    masterJson: {
      h: "Master Json"
      n: "masterJson"
      r: true
      sh: "Master JSON object containing all translations organized by workflow identifier"
      t: "`$OBJECT`"
    }
    message: {
      h: "Message"
      n: "message"
      r: true
      sh: "Human-readable message describing the import result"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      sh: "Overall success status of the import operation"
      t: "`$BOOLEAN`"
    }
    successful: {
      h: "Successful"
      n: "successful"
      r: false
      sh: "List of resource IDs that were successfully imported"
      t: "`$ARRAY`"
    }
  }

  name: "import_master_json_response_dto"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v2/translations/master-json"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/translations/master-json"
          q: {
            exist: [
              "idempotency_key"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "translations"
            }
            {
              lit: "master-json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /v2/translations/master-json/upload"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/translations/master-json/upload"
          q: {
            exist: [
              "idempotency_key"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "translations"
            }
            {
              lit: "master-json"
            }
            {
              lit: "upload"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
