# Entity: trigger

main: kit: entity: trigger: {

  alias: field: {}

  fields: {
    actor: {
      h: "Actor"
      n: "actor"
      r: false
      sh: "It is used to display the Avatar of the provided actor's subscriber id or actor object."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    agentId: {
      h: "Agent Id"
      n: "agentId"
      r: false
      sh: "Override the workflow-assigned agent for this trigger using the public agent identifier."
      t: "`$STRING`"
    }
    bridgeUrl: {
      h: "Bridge Url"
      n: "bridgeUrl"
      r: false
      sh: "Optional Bridge Endpoint URL used to route this trigger to a specific Bridge application."
      t: "`$STRING`"
    }
    context: {
      h: "Context"
      n: "context"
      r: false
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The trigger identifier of the workflow you wish to send."
      t: "`$STRING`"
    }
    overrides: {
      h: "Overrides"
      n: "overrides"
      r: false
      sh: "This could be used to override provider specific configurations"
      t: "`$ANY`"
    }
    payload: {
      h: "Payload"
      n: "payload"
      r: false
      sh: "The payload object is used to pass additional custom information that could be used to render the workflow, or perform routing rules based on it."
      t: "`$OBJECT`"
    }
    tenant: {
      h: "Tenant"
      n: "tenant"
      r: false
      sh: "It is used to specify a tenant context during trigger event."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    to: {
      h: "To"
      n: "to"
      r: true
      sh: "The recipients list of people who will receive the notification."
      t: "`$ANY`"
      union: {
        branches: 4
        count: 2
        depth: 3
      }
    }
    transactionId: {
      h: "Transaction Id"
      n: "transactionId"
      r: false
      sh: "A unique identifier for deduplication."
      t: "`$STRING`"
    }
  }

  name: "trigger"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/events/trigger"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
                or: "idempotency_key"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/events/trigger"
          q: {
            exist: [
              "idempotency_key"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "events"
            }
            {
              lit: "trigger"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
