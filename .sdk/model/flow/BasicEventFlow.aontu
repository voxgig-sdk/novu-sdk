# BasicEventFlow

main: kit: flow: BasicEventFlow:
{
  entity: "event",
  kind: "basic",
  name: "BasicEventFlow",
  step: [
    {
      i: {
        ref: "event_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "event_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "event01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicEventFlow"
}