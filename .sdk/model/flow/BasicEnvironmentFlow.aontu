# BasicEnvironmentFlow

main: kit: flow: BasicEnvironmentFlow:
{
  entity: "environment",
  kind: "basic",
  name: "BasicEnvironmentFlow",
  step: [
    {
      i: {
        ref: "environment_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "environment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "environment_ref01",
        srcdatavar: "environment_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "environment_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "environment01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "environment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnvironmentFlow"
}