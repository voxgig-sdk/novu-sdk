# BasicSubscriberFlow

main: kit: flow: BasicSubscriberFlow:
{
  entity: "subscriber",
  kind: "basic",
  name: "BasicSubscriberFlow",
  step: [
    {
      i: {
        ref: "subscriber_ref01"
      }

      m: {
        subscriber_id: "subscriber01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscriber_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscriber_ref01",
        srcdatavar: "subscriber_ref01_data",
        suffix: "_up0",
        textfield: "avatar"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscriber_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscriber_ref01",
        srcdatavar: "subscriber_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "subscriber01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-subscriber_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "subscriber_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "subscriber01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "subscriber_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriberFlow"
}