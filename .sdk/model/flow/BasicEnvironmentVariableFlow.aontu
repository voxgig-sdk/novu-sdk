        }
      ]
    }

    {
      i: {
        ref: "environment_variable_ref01",
        srcdatavar: "environment_variable_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_variable_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "environment_variable_ref01",
        srcdatavar: "environment_variable_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "environment_variable01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_variable_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "environment_variable_ref01",
        suffix: "_rm0"
      }

      m: {
